# Supabase Configuration (Optional - The app works 100% offline out of the box)
# When you want to enable Supabase Auth, Leaderboard, and Daily CA sync:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Automated Daily Current Affairs Cron & AI Generation (Optional)
# CRON_SECRET protects the /api/daily-ca/cron endpoint from unauthorized triggers
CRON_SECRET=your_random_secret_token_here

# (Optional) Google Gemini API Key for dynamic real-time AI news synthesis
# If omitted, the platform uses its built-in editorial dataset engine
GEMINI_API_KEY=your_gemini_api_key_here

